/*
    Chaeum Drive (2026-11-18): light wizard that matches the main window.
    Pages are drawn on the window background; fonts and controls come from the application style sheet.
    @{WIZARD_BACKGROUND_COLOR} and @{WIZARD_FONT_COLOR} are still provided by the loader but are no longer used.
 */
#contentWidget { background-color: #f4f6f9; }

#contentWidget QLabel { color: #1f2937; }

#contentWidget QLabel#welcomeTextLabel,
#contentWidget QLabel#youreAllSetLabel { font-size: 24px; font-weight: 700; }

#contentWidget QLabel#serverUrlLabel,
#contentWidget QLabel#pleaseLogIntoLabel,
#contentWidget QLabel#urlLabel,
#contentWidget QLabel#enterYourCredentialsLabel { font-size: 14px; color: #5b6778; }

#contentWidget QLineEdit { min-height: 38px; font-size: 14px; }

#contentWidget #advancedConfigGroupBox { border: 0; background: transparent; margin-top: 0; padding: 0; }
#contentWidget #advancedConfigGroupBoxContentWidget { background: transparent; }
#contentWidget #syncModeGroupBox,
#contentWidget #localDirectoryGroupBox { background: #ffffff; border: 1px solid #e3e8ef; border-radius: 10px; margin-top: 0; padding: 10px 14px; }
#contentWidget #syncModeGroupBox QLabel,
#contentWidget #localDirectoryGroupBox QLabel { color: #5b6778; font-weight: 700; }
#contentWidget QRadioButton { min-height: 28px; }
#contentWidget QLabel#youreAllSetLabel { margin-bottom: 8px; }

// Modified by ChaeumAI Inc. on 2026-11-16: company, product name and description for Chaeum Drive.
#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @MIRALL_VERSION_MAJOR@,@MIRALL_VERSION_MINOR@,@MIRALL_VERSION_PATCH@,@OC_RC_VERSION_BUILD@
    PRODUCTVERSION @MIRALL_VERSION_MAJOR@,@MIRALL_VERSION_MINOR@,@MIRALL_VERSION_PATCH@,@OC_RC_VERSION_BUILD@
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS VS_FF_DEBUG
#else
    FILEFLAGS 0x0L
#endif
    FILEOS VOS__WINDOWS32
    FILETYPE @OC_RC_TYPE@
    FILESUBTYPE VFT2_UNKNOWN
    BEGIN
        BLOCK "StringFileInfo"
        BEGIN
            BLOCK "040904E4"
            BEGIN
                VALUE "CompanyName", "ChaeumAI Inc.\0"
                VALUE "LegalCopyright", "Copyright (C) 2026 ChaeumAI Inc. (modifications)\r\nCopyright (C) 2025-@MIRALL_VERSION_YEAR@ OpenCloud GmbH\r\nCopyright (C) 2014-@MIRALL_VERSION_YEAR@ ownCloud GmbH\0"
                VALUE "FileVersion", "@MIRALL_VERSION_FULL@\0"
                VALUE "Comments", "@MIRALL_VERSION_STRING@\0"
                VALUE "FileDescription", "Chaeum Drive (based on OpenCloud Desktop)\0"
                VALUE "ProductName", "Chaeum Drive\0"
                VALUE "ProductVersion", "@MIRALL_VERSION_STRING@\0"
            END
        END
    BLOCK "VarFileInfo"
    BEGIN
        // English US, Unicode
        VALUE "Translation", 0x0409, 1200
    END
END
